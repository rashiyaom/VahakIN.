      "size": 17
    },
    {
      "kind": "text",
      "text": "LOCATION & GEOFENCE",
      "x": 219,
      "y": 219,
      "w": 170,
      "h": 9,
      "size": 18
    },
    {
      "kind": "text",
      "text": "Each target device supplies GNSS fixes. Basic qualifies fixes with at least five satellites, HDOP \u22642.5 and age \u226415 s. Two accepted fixes 3\u201330 s apart beyond the configured radius plus 25 m confirm a Basic geofence exit.",
      "x": 205,
      "y": 233,
      "w": 184,
      "h": 24,
      "size": 13.1
    },
    {
      "kind": "image",
      "file": "location-plot.png",
