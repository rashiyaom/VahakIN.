# VahakIN Environment Variables Template
# Copy to .env (never commit real secrets or device credentials).

# --- Web (Public / Browser-Exposed) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# --- Backend / API (Server-Only) ---
APP_ENV=dev
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
DEVICE_SECRET_MASTER_KEY_REF=local-dev-kms-or-vault-ref
TRANSPORT_RECORDS_MODE=MANUAL
ALLOWED_ORIGINS=http://localhost:3000
REPORT_BUCKET=vahakin-reports-private
NOTIFICATION_MODE=in_app
LOG_LEVEL=INFO

# Optional credential-only demo access. Copy web values into apps/web/.env.local.
VAHAKIN_DEMO_EMAIL=demo@gmail.com
VAHAKIN_DEMO_PASSWORD_SHA256=replace-with-sha256-of-demo-password

# Optional satellite / hybrid basemaps. Public browser key; restrict allowed origins.
NEXT_PUBLIC_MAPTILER_KEY=
